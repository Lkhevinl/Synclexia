{
  "expo": {
    "name": "Synclexia",
    "slug": "Synclexia",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "dedb3934-30bb-4ec0-9651-38d930042e3d"
      }
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9a8c9"
    },
    "scheme": "synclexia",
    "plugins": [
      "expo-speech-recognition",
      "expo-image-picker"
    ],
    "ios": {
      "bundleIdentifier": "com.synclexia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access the camera for scanning text.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library for scanning text.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.synclexia.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f9a8c9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "natchkun",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dedb3934-30bb-4ec0-9651-38d930042e3d"
    }
  }
}
