EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OCR.space API key — get a free key from https://ocr.space/ocrapi
EXPO_PUBLIC_OCR_API_KEY=your-ocr-space-api-key-here

# ElevenLabs TTS (optional — falls back to expo-speech if not set)
EXPO_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
EXPO_PUBLIC_ELEVENLABS_MODEL=eleven_multilingual_v2

# Password reset redirect URL (the hosted web-reset page)
EXPO_PUBLIC_PASSWORD_RESET_URL=https://synclexia-password-reset.netlify.app

# Service role key — NEVER expose this in the app (server/seeder scripts only)
# Get it from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Personal Access Token — needed only for running migrations (migrate_parent_rpc.js)
# Get it from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-token-here

# Optional: override seeder defaults
SEED_ADMIN_EMAIL=admin@synclexia.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin
