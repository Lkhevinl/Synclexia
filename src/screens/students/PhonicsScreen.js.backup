// ═══════════════════════════════════════════════════════════════════════════════
// MAIN SCREEN
// ═══════════════════════════════════════════════════════════════════════════════

export default function PhonicsScreen() {
  const navigation = useNavigation();
  const { profile } = useAuth();
  const { colors } = useTheme();
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [selectedGroup, setSelectedGroup] = useState(null);
  const [selectedSound, setSelectedSound] = useState(null);
  const [soundModalVisible, setSoundModalVisible] = useState(false);
  const [trickyModalVisible, setTrickyModalVisible] = useState(false);
  const tapCountRef = React.useRef(0);
  const lastLogRef = React.useRef(0);

  useEffect(() => {
    fetchPhonics();
  }, []);

  const fetchPhonics = async () => {
    try {
      const { data, error } = await supabase.from('phonics_items').select('*').order('label');
      if (error) console.warn('[PhonicsScreen] fetch error:', error.message);
      if (data) setItems(data);
    } catch (e) {
      console.warn('[PhonicsScreen] fetchPhonics failed:', e);
    } finally {
      setLoading(false);
    }
  };

  const handleGroupSelect = (group) => {
    setSelectedGroup(group);
    if (group.sounds.length > 0) {
      setSelectedSound(group.sounds[0]);
      setSoundModalVisible(true);
    }
  };

  const handleNextSound = () => {
    if (!selectedGroup || !selectedSound) return;
    const currentIndex = selectedGroup.sounds.findIndex(s => s.letter === selectedSound.letter);
    if (currentIndex < selectedGroup.sounds.length - 1) {
      setSelectedSound(selectedGroup.sounds[currentIndex + 1]);
    }
  };

  const handlePrevSound = () => {
    if (!selectedGroup || !selectedSound) return;
    const currentIndex = selectedGroup.sounds.findIndex(s => s.letter === selectedSound.letter);
    if (currentIndex > 0) {
      setSelectedSound(selectedGroup.sounds[currentIndex - 1]);
    }
  };

  const getCurrentSoundIndex = () => {
    if (!selectedGroup || !selectedSound) return 0;
    return selectedGroup.sounds.findIndex(s => s.letter === selectedSound.letter);
  };

  return (
    <ScreenWrapper role="student" padded={false} edges={['left','right','bottom']} style={{ backgroundColor: colors.surface }}>
      <StudentPageHeader title="Jolly Phonics" />

      <StudentCard variant="tinted" style={styles.hintCard}>
        <View style={styles.hintRow}>
          <Icon name="music" size="md" color={c.primary} />
          <Text style={styles.hintText}>
            <Text style={{ fontWeight: 'bold' }}>How to learn: </Text>
            Tap a group to explore the sounds! Each sound has a fun action and story to help you remember!
          </Text>
        </View>
      </StudentCard>

      <GroupSelector
        onSelectGroup={handleGroupSelect}
        onSelectTrickyWords={() => setTrickyModalVisible(true)}
      />

      {/* Sound Detail Modal */}
      <SoundDetailModal
        visible={soundModalVisible}
        sound={selectedSound}
        group={selectedGroup}
        onClose={() => setSoundModalVisible(false)}
        onNext={handleNextSound}
        onPrev={handlePrevSound}
        hasNext={selectedGroup && getCurrentSoundIndex() < selectedGroup.sounds.length - 1}
        hasPrev={selectedGroup && getCurrentSoundIndex() > 0}
      />

      {/* Tricky Words Modal */}
      <TrickyWordsModal
        visible={trickyModalVisible}
        onClose={() => setTrickyModalVisible(false)}
      />
    </ScreenWrapper>
  );
}

const styles = StyleSheet.create({
  hintCard: { marginHorizontal: 16, marginBottom: 12 },
  hintRow: { flexDirection: 'row', alignItems: 'flex-start', gap: 10 },
  hintText: { flex: 1, fontSize: 13, color: c.textMuted, lineHeight: 19 },
});