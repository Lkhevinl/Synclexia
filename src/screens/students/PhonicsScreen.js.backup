function AnimatedCard({ children, style, onPress, delay = 0 }) {
  const scaleAnim = useRef(new Animated.Value(0.8)).current;
  const opacityAnim = useRef(new Animated.Value(0)).current;
  const pressAnim = useRef(new Animated.Value(1)).current;

  useEffect(() => {
    Animated.parallel([
      Animated.spring(scaleAnim, { toValue: 1, useNativeDriver: true, friction: 6, delay }),
      Animated.timing(opacityAnim, { toValue: 1, duration: 300, useNativeDriver: true, delay }),
    ]).start();
  }, []);

  const handlePressIn = () => {
    Animated.spring(pressAnim, { toValue: 0.95, useNativeDriver: true, friction: 5 }).start();
  };
  const handlePressOut = () => {
    Animated.spring(pressAnim, { toValue: 1, useNativeDriver: true, friction: 5 }).start();
  };

  return (
    <Animated.View style={[style, { transform: [{ scale: Animated.multiply(scaleAnim, pressAnim) }], opacity: opacityAnim }]}>
      <TouchableOpacity onPress={onPress} onPressIn={handlePressIn} onPressOut={handlePressOut} activeOpacity={1} style={{ flex: 1 }}>
        {children}
      </TouchableOpacity>
    </Animated.View>
  );
} // Close AnimatedCard component

function GroupSelector({ onSelectGroup, onSelectTrickyWords, progress = {} }) {
  const headerAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    Animated.spring(headerAnim, { toValue: 1, useNativeDriver: true, friction: 6 }).start();
  }, []);

  const totalLearned = Object.values(progress).filter(Boolean).length;
  const totalSounds = JOLLY_PHONICS_GROUPS.reduce((sum, g) => sum + g.sounds.length, 0);
  const progressPercent = Math.round((totalLearned / totalSounds) * 100);

  return (
    <ScrollView contentContainerStyle={gs.container} showsVerticalScrollIndicator={false}>
      {/* Jolly Header */}
      <Animated.View style={{ transform: [{ scale: headerAnim }], opacity: headerAnim }}>
        <LinearGradient
          colors={['#667eea', '#764ba2']}
          start={{ x: 0, y: 0 }}
          end={{ x: 1, y: 1 }}
          style={gs.headerCard}
        >
          <View style={gs.headerContent}>
            <Text style={gs.headerEmoji}>🎵</Text>
            <Text style={gs.title}>Jolly Phonics</Text>
            <Text style={gs.sub}>Learn 42 letter sounds with songs and actions!</Text>
            
            {/* Progress Bar */}
            <View style={gs.progressContainer}>
              <View style={gs.progressBar}>
                <View style={[gs.progressFill, { width: `${progressPercent}%` }]} />
              </View>
              <Text style={gs.progressText}>{totalLearned}/{totalSounds} sounds learned</Text>
            </View>
          </View>
        </LinearGradient>
      </Animated.View>

      {/* Groups Grid */}
      <View style={gs.sectionTitle}>
        <Text style={gs.sectionTitleText}>📚 Letter Groups</Text>
        <Text style={gs.sectionTitleSub}>Tap a group to explore sounds</Text>
      </View>
      
      <View style={gs.groupsGrid}>
        {JOLLY_PHONICS_GROUPS.map((group, index) => {
          const learnedCount = group.sounds.filter(s => progress[s.letter]).length;
          const isComplete = learnedCount === group.sounds.length;
          
          return (
            <AnimatedCard key={group.id} style={gs.groupCardWrapper} onPress={() => onSelectGroup(group)} delay={index * 80}>
              <LinearGradient colors={group.gradient} style={gs.groupCard}>
                {isComplete && (
                  <View style={gs.completeBadge}>
                    <Text style={gs.completeBadgeText}>✓</Text>
                  </View>
                )}
                
                <View style={gs.groupHeader}>
                  <Text style={gs.groupName}>{group.name}</Text>
                  <View style={[gs.soundCountBadge, isComplete && gs.soundCountBadgeComplete]}>
                    <Text style={[gs.soundCountText, isComplete && gs.soundCountTextComplete]}>
                      {learnedCount}/{group.sounds.length}
                    </Text>
                  </View>
                </View>
                
                <View style={gs.soundLetters}>
                  {group.sounds.map((sound, i) => (
                    <View key={i} style={[
                      gs.letterBadge,
                      progress[sound.letter] && gs.letterBadgeLearned
                    ]}>
                      <Text style={[
                        gs.letterBadgeText,
                        progress[sound.letter] && gs.letterBadgeTextLearned
                      ]}>
                        {sound.letter}
                      </Text>
                    </View>
                  ))}
                </View>
                
                {isComplete && (
                  <View style={gs.starsContainer}>
                    <Text style={gs.starsText}>⭐⭐⭐</Text>
                  </View>
                )}
                
                <View style={gs.groupShine} />
              </LinearGradient>
            </AnimatedCard>
          );
        })}
      </View>

      {/* Tricky Words Card */}
      <AnimatedCard style={gs.trickyCardWrapper} onPress={onSelectTrickyWords} delay={600}>
        <LinearGradient colors={['#FF8A80', '#E57373']} style={gs.trickyCard}>
          <View style={gs.trickyLeft}>
            <View style={gs.trickyIconCircle}>
              <Text style={gs.trickyIcon}>⚡</Text>
            </View>
            <View>
              <Text style={gs.trickyTitle}>Tricky Words</Text>
              <Text style={gs.trickyDesc}>Words that don't follow the rules!</Text>
            </View>
          </View>
          <View style={gs.trickyRight}>
            <View style={gs.trickyCountBadge}>
              <Text style={gs.trickyCountText}>21</Text>
            </View>
            <Icon name="chevron-right" size="md" color="rgba(255,255,255,0.7)" />
          </View>
          <View style={gs.trickyShine} />
        </LinearGradient>
      </AnimatedCard>

      {/* Quick Stats */}
      <View style={gs.statsContainer}>
        <View style={gs.statBox}>
          <Text style={gs.statNumber}>7</Text>
          <Text style={gs.statLabel}>Groups</Text>
        </View>
        <View style={gs.statDivider} />
        <View style={gs.statBox}>
          <Text style={gs.statNumber}>42</Text>
          <Text style={gs.statLabel}>Sounds</Text>
        </View>
        <View style={gs.statDivider} />
        <View style={gs.statBox}>
          <Text style={gs.statNumber}>21</Text>
          <Text style={gs.statLabel}>Tricky Words</Text>
        </View>
      </View>
    </ScrollView>
  );
}

function SoundDetailModal({ visible, sound, group, onClose, onNext, onPrev, hasNext, hasPrev }) {
  const fadeAnim = useRef(new Animated.Value(0)).current;
  const slideAnim = useRef(new Animated.Value(300)).current;

  useEffect(() => {
    if (visible) {
      fadeAnim.setValue(0);
      slideAnim.setValue(300);
      Animated.parallel([
        Animated.timing(fadeAnim, { toValue: 1, duration: 200, useNativeDriver: true }),
        Animated.spring(slideAnim, { toValue: 0, useNativeDriver: true, friction: 8 }),
      ]).start();
      if (sound) {
        Speech.speak(`${sound.letter} says ${sound.sound}`, { rate: 0.8, pitch: 1.1 });
      }
    }
  }, [visible, sound]);

  if (!sound || !group) return null;

  const handleActionPress = () => {
    Speech.speak(sound.action, { rate: 0.85, pitch: 1.0 });
  };

  const handleStoryPress = () => {
    Speech.speak(sound.story, { rate: 0.85, pitch: 1.1 });
  };

  return (
    <Modal visible={visible} transparent animationType="none" onRequestClose={onClose}>
      <Animated.View style={[sd.overlay, { opacity: fadeAnim }]}>
        <Animated.View style={[sd.container, { transform: [{ translateY: slideAnim }] }]}>
          <LinearGradient colors={group.gradient} style={sd.header}>
            <TouchableOpacity onPress={onClose} style={sd.closeBtn}>
              <Icon name="x" size="md" color="#fff" />
            </TouchableOpacity>
            <Text style={sd.headerLetter}>{sound.letter}</Text>
            <Text style={sd.headerSound}>says "{sound.sound}"</Text>
          </LinearGradient>

          <ScrollView contentContainerStyle={sd.content} showsVerticalScrollIndicator={false}>
            {/* Action Section */}
            <TouchableOpacity style={sd.sectionCard} onPress={handleActionPress} activeOpacity={0.8}>
              <View style={[sd.sectionIcon, { backgroundColor: group.color }]}>
                <Icon name="hand" size="lg" color="#fff" />
              </View>
              <View style={sd.sectionText}>
                <Text style={sd.sectionTitle}>Action</Text>
                <Text style={sd.sectionDesc}>{sound.action}</Text>
                <Text style={sd.tapHint}>Tap to hear action</Text>
              </View>
            </TouchableOpacity>

            {/* Story Section */}
            <TouchableOpacity style={sd.sectionCard} onPress={handleStoryPress} activeOpacity={0.8}>
              <View style={[sd.sectionIcon, { backgroundColor: group.color }]}>
                <Icon name="book-open" size="lg" color="#fff" />
              </View>
              <View style={sd.sectionText}>
                <Text style={sd.sectionTitle}>Story</Text>
                <Text style={sd.sectionDesc}>{sound.story}</Text>
                <Text style={sd.tapHint}>Tap to hear story</Text>
              </View>
            </TouchableOpacity>

            {/* Examples Section */}
            <View style={sd.examplesCard}>
              <Text style={sd.examplesTitle}>Example Words</Text>
              <View style={sd.examplesRow}>
                {sound.example.split(', ').map((word, i) => (
                  <TouchableOpacity
                    key={i}
                    style={sd.exampleBadge}
                    onPress={() => Speech.speak(word, { rate: 0.8 })}
                  >
                    <Text style={sd.exampleText}>{word}</Text>
                  </TouchableOpacity>
                ))}
              </View>
            </View>
          </ScrollView>

          {/* Navigation */}
          <View style={sd.navBar}>
            <TouchableOpacity
              style={[sd.navBtn, !hasPrev && sd.navBtnDisabled]}
              onPress={onPrev}
              disabled={!hasPrev}
            >
              <Icon name="chevron-left" size="lg" color={hasPrev ? group.color : '#ccc'} />
            </TouchableOpacity>

            <TouchableOpacity
              style={[sd.speakBtn, { backgroundColor: group.color }]}
              onPress={() => Speech.speak(`${sound.letter} says ${sound.sound}`, { rate: 0.8 })}
            >
              <Icon name="volume-2" size="md" color="#fff" />
              <Text style={sd.speakBtnText}>Hear Sound</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={[sd.navBtn, !hasNext && sd.navBtnDisabled]}
              onPress={onNext}
              disabled={!hasNext}
            >
              <Icon name="chevron-right" size="lg" color={hasNext ? group.color : '#ccc'} />
            </TouchableOpacity>
          </View>
        </Animated.View>
      </Animated.View>
    </Modal>
  );
}

function TrickyWordsModal({ visible, onClose }) {
  const fadeAnim = useRef(new Animated.Value(0)).current;
  const [selectedLevel, setSelectedLevel] = useState(1);

  useEffect(() => {
    if (visible) {
      Animated.timing(fadeAnim, { toValue: 1, duration: 200, useNativeDriver: true }).start();
    } else {
      fadeAnim.setValue(0);
    }
  }, [visible]);

  const filteredWords = TRICKY_WORDS.filter(w => w.level === selectedLevel);

  const handleWordPress = (word) => {
    Speech.speak(`${word.word}. ${word.hint}`, { rate: 0.8, pitch: 1.1 });
  };

  return (
    <Modal visible={visible} transparent animationType="none" onRequestClose={onClose}>
      <Animated.View style={[tw.overlay, { opacity: fadeAnim }]}>
        <View style={tw.container}>
          <LinearGradient colors={['#FF8A80', '#E57373']} style={tw.header}>
            <TouchableOpacity onPress={onClose} style={tw.closeBtn}>
              <Icon name="x" size="md" color="#fff" />
            </TouchableOpacity>
            <Text style={tw.headerEmoji}>⚡</Text>
            <Text style={tw.headerTitle}>Tricky Words</Text>
            <Text style={tw.headerSubtitle}>These words don't follow the rules!</Text>
          </LinearGradient>

          {/* Level Selector */}
          <View style={tw.levelSelector}>
            {[1, 2, 3, 4].map(level => (
              <TouchableOpacity
                key={level}
                style={[tw.levelBtn, selectedLevel === level && tw.levelBtnActive]}
                onPress={() => setSelectedLevel(level)}
              >
                <Text style={[tw.levelBtnText, selectedLevel === level && tw.levelBtnTextActive]}>
                  Level {level}
                </Text>
              </TouchableOpacity>
            ))}
          </View>

          {/* Words Grid */}
          <ScrollView contentContainerStyle={tw.wordsGrid} showsVerticalScrollIndicator={false}>
            {filteredWords.map((word, index) => (
              <TouchableOpacity
                key={word.word}
                style={tw.wordCard}
                onPress={() => handleWordPress(word)}
                activeOpacity={0.8}
              >
                <Text style={tw.wordText}>{word.word}</Text>
              </TouchableOpacity>
            ))}
          </ScrollView>
        </View>
      </Animated.View>
    </Modal>
  );
}

